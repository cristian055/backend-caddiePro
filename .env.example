# Database (MongoDB)
# Format: mongodb+srv://user:password@host.mongodb.net/DATABASE_NAME?options
DATABASE_URL=mongolink+srv://your_db_user:your_db_password@your_cluster.mongodb.net/your_database?appName=yourAppName

# Server
PORT=3000
NODE_ENV=development

# CORS - Comma-separated list of allowed origins
# Use * for development (allows all), or specify your frontend URLs
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
