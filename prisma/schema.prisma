// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Caddie {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  listNumber  Int          // 1, 2, or 3
  status      String       @default("Disponible") // Disponible, En campo, Ausente
  phoneNumber String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  turns       Turn[]       @relation("CaddieTurns")
  attendance  Attendance[] @relation("CaddieAttendance")
  queue       CaddieQueue?

  @@map("caddies")
}

model Turn {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  caddieId   String   @db.ObjectId
  caddieName String
  listNumber Int
  startTime  DateTime @default(now())
  endTime    DateTime?
  completed  Boolean  @default(false)
  caddie     Caddie   @relation("CaddieTurns", fields: [caddieId], references: [id], onDelete: Cascade)

  @@map("turns")
}

model Attendance {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  caddieId    String    @db.ObjectId
  caddieName  String
  listNumber  Int
  date        DateTime  @db.Date
  status      String    // Presente, Llegó tarde, No vino, Permiso
  callTime    DateTime  @default(now())
  arrivalTime DateTime?
  turnsCount  Int       @default(0)
  endTime     DateTime?
  createdAt   DateTime  @default(now())
  caddie      Caddie    @relation("CaddieAttendance", fields: [caddieId], references: [id], onDelete: Cascade)

  @@unique([caddieId, date])
  @@map("attendance")
}

model ListSettings {
  listNumber Int     @id @map("_id")
  callTime   String  @default("06:00") // HH:mm format
  order      String  @default("ascendente") // ascendente or descendente
  rangeStart Int     @default(1)
  rangeEnd   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("list_settings")
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  targetList Int?    // null means all lists
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  @@map("messages")
}

model CaddieQueue {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  caddieId   String   @unique @db.ObjectId
  position   Int      @default(0)
  listNumber Int
  available  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  caddie     Caddie   @relation(fields: [caddieId], references: [id], onDelete: Cascade)

  @@map("caddie_queue")
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}
